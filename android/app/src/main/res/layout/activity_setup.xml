<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/QuickCheckScreenHeading" android:text="@string/setup_heading" />
        <ImageView style="@style/QuickCheckSmallLogo" android:contentDescription="@null" android:importantForAccessibility="no" />
        <EditText android:id="@+id/systemNameInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:backgroundTint="@color/white" android:hint="@string/system_name_hint" android:textColorHint="#FFE0E0" android:inputType="textCapSentences" android:textColor="@color/white" android:textSize="18sp" android:importantForAutofill="no" />
        <EditText android:id="@+id/systemPurposeInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:backgroundTint="@color/white" android:gravity="top|start" android:hint="@string/system_purpose_hint" android:textColorHint="#FFE0E0" android:inputType="textCapSentences|textMultiLine" android:minHeight="96dp" android:minLines="3" android:textColor="@color/white" android:textSize="18sp" android:importantForAutofill="no" />
        <EditText android:id="@+id/organizationInput" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:backgroundTint="@color/white" android:hint="@string/organization_hint" android:textColorHint="#FFE0E0" android:inputType="textCapWords" android:textColor="@color/white" android:textSize="18sp" android:importantForAutofill="no" />
        <Button android:id="@+id/setupNextButton" style="@style/QuickCheckButton" android:layout_marginTop="28dp" android:text="@string/next_question" />
        <Button android:id="@+id/setupBackButton" style="@style/QuickCheckButton" android:layout_marginTop="12dp" android:text="@string/back" />
    </LinearLayout>
</ScrollView>
