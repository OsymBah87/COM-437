<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/QuickCheckScreenHeading" android:text="@string/results_heading" />
        <ImageView style="@style/QuickCheckSmallLogo" android:contentDescription="@null" android:importantForAccessibility="no" />
        <TextView android:id="@+id/resultsSummaryText" style="@style/QuickCheckBodyText" android:layout_marginTop="18dp" android:background="@color/white" android:padding="16dp" android:text="@string/results_preview" android:textColor="@color/quickcheck_dark_blue" android:textStyle="bold" />
        <TextView android:id="@+id/resultsCategoryText" style="@style/QuickCheckBodyText" android:layout_marginTop="24dp" android:text="@string/results_categories_preview" />
        <TextView android:id="@+id/resultsRecommendationsText" style="@style/QuickCheckBodyText" android:layout_marginTop="24dp" android:text="@string/results_recommendations_preview" />
        <Button android:id="@+id/resultsSaveButton" style="@style/QuickCheckButton" android:layout_marginTop="28dp" android:text="@string/save_assessment" />
        <Button android:id="@+id/resultsSavedButton" style="@style/QuickCheckButton" android:layout_marginTop="12dp" android:text="@string/view_saved_assessments" />
        <Button android:id="@+id/resultsHomeButton" style="@style/QuickCheckButton" android:layout_marginTop="12dp" android:text="@string/return_home" />
    </LinearLayout>
</ScrollView>
