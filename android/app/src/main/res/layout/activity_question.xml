<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/questionCategoryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/question_category_placeholder"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/questionProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="18"
            android:progress="1" />

        <TextView
            android:id="@+id/questionProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/question_progress_placeholder"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/question_text_placeholder"
            android:textSize="21sp" />

        <RadioGroup
            android:id="@+id/responseGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <RadioButton
                android:id="@+id/responseYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yes" />

            <RadioButton
                android:id="@+id/responseNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />

            <RadioButton
                android:id="@+id/responsePartly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partly" />

            <RadioButton
                android:id="@+id/responseNotSure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not Sure" />
        </RadioGroup>

        <Button
            android:id="@+id/questionNextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/next_question" />

        <Button
            android:id="@+id/questionBackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Back" />
    </LinearLayout>
</ScrollView>
